---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Algo se construye en silencio">
  <main class="min-h-screen flex flex-col items-center justify-center 
               bg-gradient-to-b from-black via-fuchsia-950 to-black text-white 
               px-6 py-16 relative overflow-hidden">

    <!-- Luces flotantes -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-[10%] left-[5%] w-60 h-60 bg-yellow-300 rounded-full blur-[150px] opacity-20 animate-spin-slow"></div>
      <div class="absolute bottom-[20%] right-[10%] w-72 h-72 bg-fuchsia-700 rounded-full blur-[170px] opacity-25 animate-pulse-slow"></div>
      <div class="absolute top-[60%] left-[30%] w-40 h-40 bg-purple-500 rounded-full blur-[130px] opacity-20 animate-float-up"></div>
    </div>

    <div class="relative z-10 text-center max-w-4xl">

      <!-- Título -->
      <h1 class="text-6xl md:text-7xl lg:text-8xl font-black mb-16 
                 text-transparent bg-clip-text 
                 bg-gradient-to-r from-pink-400 via-white to-purple-400
                 drop-shadow-[0_0_80px_rgba(255,100,255,1)] animate-glow-epic">
        LO QUE NACIMOS A SENTIR
      </h1>

      <!-- Tarjeta -->
      <div class="bg-white/10 backdrop-blur-md border border-white/30 
                  rounded-3xl px-10 py-8 mb-16 shadow-[0_0_60px_rgba(255,50,250,1)] 
                  animate-shadow-pulse">

        <h2 class="text-3xl font-bold text-pink-300 mb-4 flex items-center justify-center">
          <span class="text-4xl mr-3 animate-spin-fast">✨</span>
          Algo hermoso está por revelarse
        </h2>

        <!-- Barra de progreso -->
        <div class="w-full bg-white/20 rounded-full h-6 overflow-hidden border-2 border-pink-400">
          <div id="progressBar" class="h-6 rounded-full bg-gradient-to-r 
               from-red-500 via-pink-500 to-purple-500 transition-all duration-1000 ease-in-out"></div>
        </div>

        <!-- Mensaje romántico -->
        <p class="mt-6 text-gray-200 text-xl italic font-serif leading-relaxed">
          A veces lo más bonito no aparece de golpe…  
          se **construye despacio**, como una mirada que se queda,  
          como una sonrisa que no se olvida,  
          como lo que tú y yo… sin darnos cuenta…  
          ya empezamos a crear.
        </p>

        <p class="mt-4 text-gray-300 text-xl italic font-serif">
          Progreso: <span id="progressText">90%</span> — Ya casi puedo mostrártelo.
        </p>
      </div>

    </div>

    <!-- Footer romántico -->
    <p class="absolute bottom-10 text-gray-300 animate-bounce text-lg">
      <span class="text-2xl">🌙</span> Un instante más... <span class="text-2xl">💖</span>
    </p>
  </main>

  <style>
    .animate-glow-epic {
      animation: glow-epic 5s ease-in-out infinite alternate;
    }

    @keyframes glow-epic {
      0% { filter: drop-shadow(0 0 40px #ff69b4); } 
      100% { filter: drop-shadow(0 0 90px #e0aaff); } 
    }

    .animate-shadow-pulse {
      animation: shadow-pulse 3s ease-in-out infinite alternate;
    }

    @keyframes shadow-pulse {
      0% { box-shadow: 0 0 40px rgba(255, 100, 250, 0.6); }
      100% { box-shadow: 0 0 70px rgba(255, 100, 250, 1.0); }
    }

    .animate-spin-fast { animation: spin 2s linear infinite; }
    .animate-spin-slow { animation: spin 150s linear infinite; }
    .animate-pulse-slow { animation: pulse-slow 25s ease-in-out infinite alternate; }
    @keyframes pulse-slow {
      0% { transform: scale(1); opacity: 0.2; }
      100% { transform: scale(1.4); opacity: 0.5; }
    }

    .animate-float-up { animation: float-up 20s ease-in-out infinite; }
    @keyframes float-up {
      0% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-70px) rotate(8deg); }
      100% { transform: translateY(0) rotate(0deg); }
    }

    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  </style>

  <script type="text/javascript">
    function updateProgress() {
      const progressBar = document.getElementById('progressBar');
      const progressText = document.getElementById('progressText');
      
      const newProgress = Math.min(100, Math.floor(Math.random() * (98 - 88) + 88)); 
      
      progressBar.style.width = newProgress + '%';

      if (newProgress >= 95) {
          progressText.innerHTML = 'Ya viene... la sorpresa que guardé para ti.';
      } else {
          progressText.textContent = newProgress + '%';
      }
    }

    updateProgress();
    setInterval(updateProgress, 3000);
  </script>
</Layout>
